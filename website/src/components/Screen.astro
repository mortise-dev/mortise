---
// A screen of Mortise, in the theme of the page.
// The images are the snapshots of the image tests (crates/mortise-app/tests/snapshots),
// so the site shows what the app draws. `id` is the file name without -dark.png or -light.png.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  alt: string;
  caption?: string;
}

const { id, alt, caption } = Astro.props;
// Lazy, so that the build copies only the images a page shows.
const shots = import.meta.glob<{ default: ImageMetadata }>(
  '../../../crates/mortise-app/tests/snapshots/*.png',
);
const find = async (theme: string) => {
  const key = Object.keys(shots).find((k) => k.endsWith(`/${id}-${theme}.png`));
  if (!key) throw new Error(`No snapshot named ${id}-${theme}.png`);
  return (await shots[key]()).default;
};
const dark = await find('dark');
const light = await find('light');
const widths = [640, 960, 1280];
const sizes = '(min-width: 72rem) 45rem, 100vw';
---

<figure class="screen not-content">
  <Image src={dark} alt={alt} widths={widths} sizes={sizes} class="dark" />
  <Image src={light} alt={alt} widths={widths} sizes={sizes} class="light" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .screen {
    margin: 1.5rem 0;
  }
  .screen img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--mortise-line-2);
    border-radius: 8px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.25);
  }
  :global([data-theme='light']) .screen .dark,
  :global([data-theme='dark']) .screen .light {
    display: none;
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
